{
  "expo": {
    "name": "XenChat",
    "slug": "xenchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0A0A1A",
      "translucent": false
    },
    "android": {
      "package": "com.xenchat.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.xenchat.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "XenChat uses Face ID to reveal encrypted messages."
      }
    },
    "plugins": [
      "expo-local-authentication",
      "expo-font",
      "expo-web-browser",
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
